# ==============================================================================
# 沐曦 (MetaX 曦云 C500 64GB) 运行时专属环境变量
# ==============================================================================

# 指定 GPGPU 设备类型与后端
export VLLM_TARGET_DEVICE="metax"
export VLLM_VENDOR="metax"

# FlagGems 算子选择与加速配置
export FLAGGEMS_BACKEND="metax"
export FLAGGEMS_ENABLE_JIT=1

# MACA 显存与图执行水线配置
export MACA_ENABLE_GRAPH_CAPTURE=1
export MACA_GRAPH_MEM_POOL_LIMIT_MB=8192

# 精度保障: 禁用不安全的激进浮点近似优化
export TRITON_FAST_MATH=0
export FLAGGEMS_FORCE_FP32_REDUCE=1

# 调试与日志等级
export VLLM_LOGGING_LEVEL="INFO"
